# Git
.git/
.gitignore

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Environment variables (must never enter the image)
.env
.env.*

# Distribution / packaging
*.egg-info/
dist/
build/
.tox/

# Test / coverage
.coverage
htmlcov/
.pytest_cache/

# Runtime data that shouldn't be baked into the image
media/
assets/

# Docs (not needed at runtime)
*.md

# Editor / OS cruft
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker artifacts
.dockerignore

# Plan/session files
.claude/
